# Deliberately invalid placeholders. Supply real configuration locally only.
# The provider reads environment variables, not this file automatically.
KMB_BASE_URL=https://example.invalid/v1
KMB_API_KEY=not-a-real-key-replace-locally
KMB_MODEL=replace-with-verified-model-id
KMB_API_STYLE=chat_completions
# Optional bounded upstream request timeout (seconds); default 60.
# Changing this changes the frozen execution/scoring identity and requires a new protocol.
KMB_UPSTREAM_TIMEOUT_SECONDS=60

# CLI real runs use a host TrialGateway configured above. KMB_AGENT_* values
# are populated internally with a per-trial gateway endpoint and disposable
# token. Never copy the real upstream key into a container profile.

# This macOS workstation's intended context. On Linux remove this line or
# replace it with an existing, verified context; never assume it exists.
KMB_DOCKER_CONTEXT=colima-kmb
